// ROOM / master — an unfinished personal exhibition
room "master"
title "Everything in\nits wrong place."
composition "floor"
palette "citrus"
surface {"width":50,"depth":24,"wall":true}
light {"color":"#fff0ce","intensity":3,"cycle":"still"}
shader {"pattern":"grain","strength":0.12,"speed":0.35,"code":""}

// at [horizontal, layer, vertical] · rotate [tilt, angle, tilt]
// relief 0–0.65: depth within the printed image
object "camera-1" camera {"at":[-3.7,0.55,-1.25],"rotate":[0,-5,0],"scale":1.5,"color":"#edff52","material":"clay","relief":0.32,"action":"gallery","content":"photos","motion":"none"}
object "turntable-1" turntable {"at":[0.65,1.25,2.05],"rotate":[0,6,0],"scale":1.35,"color":"#edff52","material":"clay","relief":0.28,"action":"music","content":"midnight-rotation"}
object "lamp-1" lamp {"at":[-7.9,0.25,3.4],"rotate":[0,8,0],"scale":0.82,"color":"#edff52","material":"clay","relief":0.34,"action":"light","motion":"none"}
object "book-1" book {"at":[6.7,0.6,-0.45],"rotate":[0,-7,0],"scale":1.15,"color":"#edff52","material":"clay","relief":0.18,"action":"article","content":"empty-time"}
object "portal-1" portal {"at":[5.45,0.85,-4.55],"rotate":[0,4,0],"scale":1.03,"color":"#edff52","material":"clay","relief":0.4,"action":"room","content":"music"}
