// ROOM / cinema — an unfinished personal exhibition
room "cinema"
title "Stay for\nthe afterimage."
composition "floor"
palette "blue"
surface {"width":50,"depth":24,"wall":true}
light {"color":"#fff0ce","intensity":3,"cycle":"still"}
shader {"pattern":"grain","strength":0.12,"speed":0.35,"code":""}

// at [horizontal, layer, vertical] · rotate [tilt, angle, tilt]
// relief 0–0.65: depth within the printed image
object "projector-1" projector {"at":[-2,0.55,-1],"rotate":[0,-5,0],"scale":1.5,"color":"#edff52","material":"clay","relief":0.32,"action":"video","content":"colour-in-motion","motion":"none"}
object "lamp-1" lamp {"at":[5,0.2,2],"rotate":[0,8,0],"scale":0.82,"color":"#edff52","material":"clay","relief":0.34,"action":"light","motion":"none"}
object "portal-1" portal {"at":[5,0.8,-4],"rotate":[0,4,0],"scale":1.03,"color":"#edff52","material":"clay","relief":0.4,"action":"room","content":"master"}
